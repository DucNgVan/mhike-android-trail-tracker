<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material 3 Standardized Input Style -->
    <style name="MHike.TextInputLayout.Outlined" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/outline</item>
    </style>

    <!-- Header Text Style -->
    <style name="MHike.Text.Header" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Bottom Nav Customization -->
    <style name="MHike.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">24dp</item>
        <item name="itemTextAppearanceActive">@style/MHike.BottomNav.Text</item>
        <item name="itemTextAppearanceInactive">@style/MHike.BottomNav.Text</item>
    </style>

    <style name="MHike.BottomNav.Text" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
    </style>
</resources>
